package main

import (
	"fmt"
	"github.com/gin-gonic/gin"
	"io"
	"os"
)

func uploadLargeFile(c *gin.Context) {
	fmt.Print(c)
	//folder, _ := c.GetPostForm("folder")
	folder, _ := c.FormFile("folder")
	idx := c.DefaultPostForm("idx", "defaultIdx")
	//fmt.Println("====>", folder)

	//OSS.UploadFile(folder)
	_, err := os.Stat("./" + folder.Filename)
	if err != nil {
		os.MkdirAll("./"+folder.Filename, os.ModePerm)
	}
	savePath := "./" + folder.Filename + "/" + idx
	filePtr, err := folder.Open()
	if err != nil {
		fmt.Println("folder error")
		return
	}
	defer filePtr.Close()

	saveFile, err := os.Create(savePath)
	if err != nil {
		fmt.Println("saveFile error")
		return
	}
	defer saveFile.Close()
	var context []byte = make([]byte, 1024)
	for {
		n, err := filePtr.Read(context)
		saveFile.Write(context[:n])
		if err != nil {
			if err == io.EOF {
				return
			}
		}
	}
}
